{
  "name": "hermes-notes",
  "productName": "Hermes Notes",
  "version": "0.2.0",
  "description": "Calm, local-first notes + tasks day-starter with Hermes orchestration",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "dev.giovanni.hermesnotes",
    "files": [
      "dist/**"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    }
  }
}
